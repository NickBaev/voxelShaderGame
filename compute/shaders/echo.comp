// Эхо-шейдер Этапа 2.1: каждый инвокейшен пишет свой глобальный ID
// в свой слот буфера. Проверяет, что compute pipeline работает end-to-end.
//
// Сборка:  glslc -O echo.comp -o echo.comp.spv   (см. Makefile)
#version 450

// Размер рабочей группы: 256 потоков на один dispatch-запуск.
// Групп будет dispatchCount = ceil(N / 256).
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Echo {
    uint data[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    data[i] = i;
}
